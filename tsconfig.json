{
  // Matches the jsconfig.json the Herdr app writes into each mod folder:
  // ES2022, no DOM or Node globals (gpui-kit.d.ts declares the runtime's own),
  // and strictPropertyInitialization off because a View sets its state in init(), not a constructor.
  // strictNullChecks stays on: Effect's types (Option, the error channel) depend on it.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "types": [],
    "strict": true,
    "strictPropertyInitialization": false,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    // Effect's language service, for the editor (TypeScript patched by `prepare`).
    // Its diagnostics come from `vp lint` instead, so they aren't shown twice.
    "plugins": [{ "name": "@effect/language-service", "diagnostics": false }],
    // The Herdr app's types, linked by `vp run types` (scripts/link-herdr-types.sh).
    // gpui-kit.d.ts declares its modules itself; herdr.d.ts is a plain module file.
    "paths": {
      "herdr": ["./.herdr-types/herdr.d.ts"]
    }
  },
  "include": ["apps/*/src", "apps/*/tests", "packages/*/src", "packages/*/tests", "herdr-env.d.ts"]
}
