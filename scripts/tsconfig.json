{
  // Root scripts and their tests run on Node (vpx, vp test), not in the Herdr app,
  // so they get Node's types. Without this file they would only see Node's types when
  // some other file in the same type-check run pulled them in, as vite-plus's types do.
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "types": ["node"],
    "paths": {}
  },
  "include": ["*.ts"]
}
